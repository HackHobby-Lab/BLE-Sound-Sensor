// 	model = "Nordic nRF52833 DK NRF52833";
// 	compatible = "nordic,nrf52833-dk-nrf52833";

#include <zephyr/dt-bindings/led/led.h>

// #include "nrf52-bindings.h"

&spi0 {
	compatible = "nordic,nrf-spi";
	status = "okay";
	pinctrl-0 = <&spi0_custom>;
	pinctrl-1 = <&spi0_sleep>;
	pinctrl-names = "default", "sleep";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";

		/* SPI */
		reg = <0>; /* ignored, but necessary for SPI bindings */
		spi-max-frequency = <4000000>;

		/* WS2812 */
		chain-length = <1>; /* arbitrary; change at will */
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
        status = "okay";
	};

	
};

/ {
	aliases {
		led-strip = &led_strip;
	};
};

&pinctrl {
	spi0_custom: spi0_custom {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 29)>,
				<NRF_PSEL(SPIM_MOSI, 0, 14)>,
				<NRF_PSEL(SPIM_MISO, 0, 30)>;
		};
	};

	spi0_sleep: spi0_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 29)>,
				<NRF_PSEL(SPIM_MOSI, 0, 14)>,
				<NRF_PSEL(SPIM_MISO, 0, 30)>;
			low-power-enable;
		};
	};
};


&gpio0 {
    status = "okay";
};


/ {
    user_output_pin: user-output-pin {
        compatible = "nordic,gpio-pins";
        gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
        status = "okay";
    };

};

/ {
    user_input_pin: user-input-pin {
        compatible = "nordic,gpio-pins";
        gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
        status = "okay";
    };
};


&pdm0 {
    status = "okay";
    pinctrl-0 = <&pdm_default>;
    pinctrl-1 = <&pdm_sleep>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {
    pdm_default: pdm_default {
        group1 {
            psels = <NRF_PSEL(PDM_CLK, 0, 27)>,
                    <NRF_PSEL(PDM_DIN, 0, 25)>;
        };
    };

    pdm_sleep: pdm_sleep {
        group1 {
            psels = <NRF_PSEL(PDM_CLK, 0, 27)>,
                    <NRF_PSEL(PDM_DIN, 0, 25)>;
            low-power-enable;
        };
    };
};

